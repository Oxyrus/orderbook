# Copy to .env (git-ignored) and adjust. The Makefile loads .env automatically.
# Every variable is documented in docs/configuration.md.

SERVICE_NAME=orderbook
# Defaults to production when unset (fail closed). Keep development locally.
APP_ENV=development

HTTP_ADDR=:8080
ADMIN_ADDR=:9090
ADMIN_ENABLE_PPROF=true

LOG_LEVEL=debug
LOG_FORMAT=console

# The Citus coordinator. The application never connects to workers.
DB_URL=postgres://orderbook:orderbook@localhost:5432/orderbook?sslmode=disable
DB_AUTO_MIGRATE=true

# Optional. `make up` starts Redis; see docs/redis.md.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Local mock OAuth2 server from docker-compose. `make token client=acme`
# mints a token whose tenant_id claim is "acme".
AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:8081/default
AUTH_AUDIENCE=orderbook-api
TENANT_CLAIM=tenant_id

# Used by `api worker` (make run-worker). Host listener of the compose Kafka.
KAFKA_BROKERS=localhost:29092

# Start Jaeger with `make up-all` and set this to true to see traces.
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

CORS_ALLOWED_ORIGINS=http://localhost:3001
